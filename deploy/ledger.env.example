# /etc/ledger/ledger.env — owned root:ledger, mode 0640 (contains the DB password).
# Read by systemd (EnvironmentFile) and by the ledger-user/ledger-backup tools.
# Keep values unquoted and free of spaces.

# Written by setup-db.sh. The application role owns nothing in the database.
DATABASE_URL=postgres://ledger_app:CHANGE_ME@127.0.0.1:5432/ledger?sslmode=disable

# Listen address. Use 127.0.0.1:8080 if a reverse proxy runs in the container.
HTTP_ADDR=:8080

# CSV import/export directory (TrueNAS bind mount).
CSV_DIR=/app/csv_data

# Session cookie Secure flag: auto (Secure when served over HTTPS or behind a
# proxy sending X-Forwarded-Proto: https), true, or false.
COOKIE_SECURE=auto

# Small footprint: few DB connections and a bounded JavaScript heap (MB).
DB_MAX_CONNS=4
LEDGER_MAX_HEAP_MB=96

# Backups: where the TrueNAS share is, and how long to keep dumps there.
# Only the defaults: once saved in the app (Settings → Backups), the app's
# settings apply.
BACKUP_DIR=/app/csv_data/backups
BACKUP_KEEP_DAYS=30

# Ledger asks GitHub for new releases of itself and of each module. Without a
# token GitHub allows this server's address 60 requests an hour, and answers
# 403 once they are used up. A GitHub token (github.com → Settings → Developer
# settings → Personal access tokens; it needs no permissions for public
# repositories) raises that to 5,000. Restart Ledger after setting it.
#LEDGER_GITHUB_TOKEN=

# The updater moves a server on an older PostgreSQL to 18 by itself, once,
# after a backup (docs/DEPLOYMENT.md, "PostgreSQL 18"). Uncomment to keep
# this server on its current PostgreSQL.
#LEDGER_PG_UPGRADE=off
