# /etc/systemd/system/ledger-update.path
# The app writes run-now when you press "Check for updates now", and
# modules-run-now when you add or remove a module.
[Unit]
Description=Run a Ledger update check when the app requests one

[Path]
PathExists=/var/lib/ledger/update-config/run-now
PathExists=/var/lib/ledger/update-config/modules-run-now
Unit=ledger-update.service

[Install]
WantedBy=paths.target
