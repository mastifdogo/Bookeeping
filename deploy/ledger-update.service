# /etc/systemd/system/ledger-update.service
# Installs new Ledger releases from GitHub on the schedule set in the app
# (Updates page), or when the app asks for a check. Started every 5 minutes
# by ledger-update.timer and on request by ledger-update.path; it exits at
# once when nothing is due. Runs as root: it installs the program and may
# reboot the container.
[Unit]
Description=Ledger automatic update
Documentation=https://github.com/mastifdogo/Bookeeping/blob/main/docs/DEPLOYMENT.md
Wants=network-online.target
After=network-online.target ledger.service

[Service]
Type=oneshot
EnvironmentFile=/etc/ledger/ledger.env
ExecStart=/usr/local/bin/ledger update run
TimeoutStartSec=30min
Nice=5
